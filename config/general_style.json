{
  "name": "Green Minimal Theme",
  "dataColors": [
    "#0B5345",
    "#1E8449",
    "#52BE80",
    "#A9DFBF",
    "#D5F5E3"
  ],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#0B5345",

  "visualStyles": {
    "card": {
      "*": {
        "general": [
          {
            "transparency": 0,
            "border": "none",
            "outline": "none",
            "cornerRadiusTopLeft": 6,
            "cornerRadiusTopRight": 6,
            "cornerRadiusBottomLeft": 6,
            "cornerRadiusBottomRight": 6
          }
        ],
        "title": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "color": { "solid": { "color": "#333333" } },
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 22,
            "color": { "solid": { "color": "#0B5345" } },
            "alignment": "right"
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#F7F7F7" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
