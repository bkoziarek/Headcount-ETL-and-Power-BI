	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR MinDate =
				    MINX(
				        UNION(
				            SELECTCOLUMNS('fact_monthly_snapshot', "Date", 'fact_monthly_snapshot'[MonthEnd]),
				            SELECTCOLUMNS('fact_employee_master', "Date", 'fact_employee_master'[EffectiveFrom])
				        ),
				        [Date]
				    )
				VAR MaxDate =
				    MAXX(
				        UNION(
				            SELECTCOLUMNS('fact_monthly_snapshot', "Date", 'fact_monthly_snapshot'[MonthEnd]),
				            SELECTCOLUMNS('fact_employee_master', "Date", 'fact_employee_master'[EffectiveFrom])
				        ),
				        [Date]
				    )
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "Month Number", MONTH([Date]),
				    "Year-Month", FORMAT([Date], "MMM YYYY"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Week Number", WEEKNUM([Date]),
				    "Day of Week", FORMAT([Date], "dddd"),
				    "Day of Week Number", WEEKDAY([Date], 2),
				    "YearQuarter", Year([Date])& " " &"Q" & QUARTER ( [Date] ),
				    "YearQuarterNumber", YEAR([Date]) * 10 + QUARTER ([Date]) ,
				    "YearMonthNumber", YEAR([Date]) * 100 + MONTH([Date])
				)
				
				```

	annotation PBI_Id = 01a6537882b845c595007396d1bd3756

